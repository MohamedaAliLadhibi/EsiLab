esilab.tn, www.esilab.tn {
	redir https://www.esilab-tunisie.com{uri} permanent
}

admin.esilab.tn {
	redir https://admin.esilab-tunisie.com{uri} permanent
}

api.esilab.tn {
	redir https://api.esilab-tunisie.com{uri} permanent
}

{$APEX_DOMAIN}, {$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy public-site:4001
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin-site:4000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy public-api:3000
}
